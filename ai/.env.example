# ai/.env 로 복사해서 쓴다(.env는 커밋하지 않는다). 값이 없으면 config.py의 기본값을 쓴다.
# Claude API 키는 여기 두지 않는다 — Spring의 claude.api.key를 요청마다 헤더로 받는다.

# 벡터 DB(Chroma). 개발은 embedded(로컬 폴더), 시스템 오픈 때 http(서버형)로 바꾼다 — 코드 수정 없이 이 값만 바꾼다.
CHROMA_MODE=embedded
CHROMA_PATH=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=trend_chunks_qwen3vl

# 임베딩 모델. Qwen/Qwen3-VL-Embedding-* 은 sentence-transformers, 그 밖의 이름은 fastembed로 돈다. 바꾸면 기존 색인과 섞이지 않게 기동이 막힌다 — 컬렉션을 새로 만들거나 재색인한다.
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B

# 청크 분할(문자 수)
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# P-06 검색: 벡터 + 키워드(BM25)를 RRF로 합친다(하이브리드). false면 벡터만
HYBRID_SEARCH=true

# P-06 리랭킹 켜기/끄기(바꾸면 AI 서비스 재기동). 켜면 근거 후보를 리랭커로 다시 매기고 근거 기준도 리랭커 점수(RERANK_MIN_SCORE, 0~1)에 건다.
# false면 Spring rag.min-score(유사도) 기준이고 리랭커 모델(메모리 약 2.3GB)을 올리지 않는다. 켜면 이 PC(CPU)에서 검색 질문이 20~30초 더 걸린다
RERANK=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.10

# 기동 때 임베딩·리랭커 모델을 백그라운드로 미리 올린다(첫 질문이 80초 가까이 더 걸리던 것을 없앤다). false면 첫 요청 때 올린다.
# 리랭커는 RERANK=true일 때만 올린다
PRELOAD_MODELS=true
